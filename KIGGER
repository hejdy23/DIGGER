function ui:Dropdown(win, page, name, list, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1,-14,0,60)
    frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
    frame.ZIndex = 10
    frame.Parent = page
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0,10)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,0,20)
    label.BackgroundTransparency = 1
    label.Text = name
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16
    label.TextColor3 = Color3.new(1,1,1)
    label.ZIndex = 11
    label.Parent = frame

    local drop = Instance.new("TextButton")
    drop.Size = UDim2.new(1,-20,0,25)
    drop.Position = UDim2.new(0,10,0,25)
    drop.BackgroundColor3 = Color3.fromRGB(40,40,40)
    drop.Text = "Select"
    drop.Font = Enum.Font.GothamBold
    drop.TextSize = 14
    drop.TextColor3 = Color3.new(1,1,1)
    drop.ZIndex = 11
    drop.Parent = frame
    Instance.new("UICorner", drop).CornerRadius = UDim.new(0,6)

    local optionHolder = Instance.new("Frame")
    optionHolder.BackgroundColor3 = Color3.fromRGB(30,30,30)
    optionHolder.Visible = false
    optionHolder.ZIndex = 1000
    optionHolder.Parent = win.Main
    Instance.new("UICorner", optionHolder).CornerRadius = UDim.new(0,6)

    local layout = Instance.new("UIListLayout")
    layout.Parent = optionHolder
    layout.Padding = UDim.new(0,2)

    local open = false

    drop.MouseButton1Click:Connect(function()
        open = not open
        optionHolder.Visible = open

        if open then
            for _,child in ipairs(optionHolder:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end

            for _,v in ipairs(list) do
                local opt = Instance.new("TextButton")
                opt.Size = UDim2.new(1,0,0,22)
                opt.BackgroundColor3 = Color3.fromRGB(50,50,50)
                opt.Text = v
                opt.Font = Enum.Font.GothamBold
                opt.TextSize = 14
                opt.TextColor3 = Color3.new(1,1,1)
                opt.ZIndex = 1001
                opt.Parent = optionHolder
                Instance.new("UICorner", opt).CornerRadius = UDim.new(0,4)

                opt.MouseButton1Click:Connect(function()
                    drop.Text = v
                    callback(v)
                    optionHolder.Visible = false
                    open = false
                end)
            end

            task.defer(function()
                local guiPos = win.Main.AbsolutePosition
                local guiSize = win.Main.AbsoluteSize
                local absPos = frame.AbsolutePosition

                optionHolder.Position = UDim2.fromOffset(
                    guiPos.X + guiSize.X + 10,
                    absPos.Y
                )

                optionHolder.Size = UDim2.fromOffset(
                    drop.AbsoluteSize.X,
                    layout.AbsoluteContentSize.Y
                )
            end)
        end
    end)

    return {
        Update = function(newList)
            list = newList
        end
    }
end

function ui:Slider(page, name, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1,-14,0,60)
    frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
    frame.ZIndex = 10
    frame.Parent = page
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0,10)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,0,20)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. string.format("%.2f", default)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16
    label.TextColor3 = Color3.new(1,1,1)
    label.ZIndex = 10
    label.Parent = frame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1,-20,0,10)
    bar.Position = UDim2.new(0,10,0,35)
    bar.BackgroundColor3 = Color3.fromRGB(40,40,40)
    bar.ZIndex = 10
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0,5)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3 = Color3.fromRGB(0,140,0)
    fill.ZIndex = 11
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,5)

    local dragging = false

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(rel,0,1,0)
            local value = min + (max-min) * rel
            label.Text = name .. ": " .. string.format("%.2f", value)
            callback(value)
        end
    end)
end

