local ui = {}

function ui:Window(title)
    local gui = Instance.new("ScreenGui")
    gui.Parent = game.CoreGui

    local main = Instance.new("Frame")
    main.Size = UDim2.new(0,420,0,360)
    main.Position = UDim2.new(.5,-210,.5,-180)
    main.BackgroundColor3 = Color3.fromRGB(0,0,0)
    main.Active = true
    main.Draggable = true
    main.ZIndex = 10
    main.Parent = gui
    Instance.new("UICorner", main).CornerRadius = UDim.new(0,12)

    local outline = Instance.new("Frame")
    outline.Size = UDim2.new(1,8,1,8)
    outline.Position = UDim2.new(0,-4,0,-4)
    outline.BackgroundColor3 = Color3.fromRGB(255,0,0)
    outline.BorderSizePixel = 0
    outline.ZIndex = 9
    outline.Parent = main
    Instance.new("UICorner", outline).CornerRadius = UDim.new(0,14)

    task.spawn(function()
        local h = 0
        while outline.Parent do
            h = (h + 1) % 360
            outline.BackgroundColor3 = Color3.fromHSV(h/360,1,1)
            task.wait(.02)
        end
    end)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1,0,0,45)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 24
    titleLabel.TextColor3 = Color3.new(1,1,1)
    titleLabel.ZIndex = 10
    titleLabel.Parent = main

    local tabs = Instance.new("Frame")
    tabs.Size = UDim2.new(0,130,1,-45)
    tabs.Position = UDim2.new(0,0,0,45)
    tabs.BackgroundColor3 = Color3.fromRGB(0,0,0)
    tabs.ZIndex = 10
    tabs.Parent = main

    local list = Instance.new("UIListLayout")
    list.Parent = tabs
    list.Padding = UDim.new(0,6)

    local pages = Instance.new("Frame")
    pages.Size = UDim2.new(1,-130,1,-45)
    pages.Position = UDim2.new(0,130,0,45)
    pages.BackgroundColor3 = Color3.fromRGB(0,0,0)
    pages.ZIndex = 10
    pages.Parent = main

    return {
        Tabs = tabs,
        Pages = pages,
        Main = main
    }
end

function ui:Tab(win, name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,-10,0,38)
    btn.BackgroundColor3 = Color3.fromRGB(10,10,10)
    btn.Text = name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.new(1,1,1)
    btn.ZIndex = 10
    btn.Parent = win.Tabs
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1,0,1,0)
    page.CanvasSize = UDim2.new(0,0,0,0)
    page.ScrollBarThickness = 4
    page.BackgroundColor3 = Color3.fromRGB(0,0,0)
    page.Visible = false
    page.ZIndex = 10
    page.Parent = win.Pages

    local layout = Instance.new("UIListLayout")
    layout.Parent = page
    layout.Padding = UDim.new(0,10)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 20)
    end)

    btn.MouseButton1Click:Connect(function()
        for _,p in ipairs(win.Pages:GetChildren()) do
            if p:IsA("ScrollingFrame") then
                p.Visible = false
            end
        end
        page.Visible = true
    end)

    return page
end

function ui:Toggle(page, name, callback)
    local t = Instance.new("TextButton")
    t.Size = UDim2.new(1,-14,0,45)
    t.BackgroundColor3 = Color3.fromRGB(25,25,25)
    t.Text = name .. ": OFF"
    t.Font = Enum.Font.GothamBold
    t.TextSize = 18
    t.TextColor3 = Color3.new(1,1,1)
    t.ZIndex = 10
    t.Parent = page
    Instance.new("UICorner", t).CornerRadius = UDim.new(0,10)

    local state = false

    t.MouseButton1Click:Connect(function()
        state = not state
        t.Text = name .. (state and ": ON" or ": OFF")
        t.BackgroundColor3 = state and Color3.fromRGB(0,140,0) or Color3.fromRGB(25,25,25)
        callback(state)
    end)
end

