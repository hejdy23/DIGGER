local tpTab = ui:Tab(win, "Teleporter")

local target = nil
local mode = "Front"
local tpOn = false
local tpConn

local function players()
    local t = {}
    for _,p in ipairs(game.Players:GetPlayers()) do
        table.insert(t, p.Name)
    end
    return t
end

local playerDrop = ui:Dropdown(win, tpTab, "Select Player", players(), function(sel)
    target = sel
end)

task.spawn(function()
    while true do
        playerDrop.Update(players())
        task.wait(1)
    end
end)

ui:Dropdown(win, tpTab, "Teleport Mode", {"Front","Back"}, function(sel)
    mode = sel
end)

local function startTP()
    if tpConn then tpConn:Disconnect() end

    tpConn = game:GetService("RunService").Heartbeat:Connect(function()
        if not tpOn or not target then return end

        local lp = game.Players.LocalPlayer
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local t = game.Players:FindFirstChild(target)
        if not t then return end

        local tc = t.Character
        local tr = tc and tc:FindFirstChild("HumanoidRootPart")
        if not tr then return end

        local off = (mode == "Front") and -3 or 3
        root.CFrame = CFrame.new(tr.Position + tr.CFrame.LookVector * off)
    end)
end

ui:Toggle(tpTab, "Teleport To Player", function(state)
    tpOn = state
    if state then
        startTP()
    else
        if tpConn then
            tpConn:Disconnect()
            tpConn = nil
        end
    end
end)
